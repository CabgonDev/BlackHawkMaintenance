          "required": true
        },
        {
          "title": "Chequear cantidad de combustible según requerido.",
          "short": "Nivel de combustible",
          "required": true,
          "photo": true
        },
        {
          "title": "Drenar combustible (primer vuelo del día) y checar por contaminación.",
          "short": "Drenaje / contaminación",
          "required": true
