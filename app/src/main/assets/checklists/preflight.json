      "title": "Antes de comenzar",
      "items": [
        {
          "title": "¡Advertencia!",
          "warning": true,
          "text": "No hacer prevuelo hasta que los sistemas de armamento estén asegurados, interruptores apagados, pasadores de seguridad instalados y palancas de seguridad en posición asegurada."
        },
        {
          "title": "Revisar bitácora de aeronave.",
          "short": "Bitácora revisada",
          "required": true
        },
        {
          "title": "Remover y asegurar cubiertas, dispositivos de cierre, amarres y cables de tierra.",
