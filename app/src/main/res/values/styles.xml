<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.BlackHawk.Drawer" parent="Widget.Material3.NavigationView">
        <item name="itemIconTint">?attr/colorOnSurface</item>
        <item name="itemTextColor">?attr/colorOnSurface</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.BlackHawk.DrawerItem</item>
        <item name="itemShapeFillColor">?attr/colorSurface</item>
        <item name="itemShapeInsetStart">12dp</item>
        <item name="itemShapeInsetEnd">12dp</item>
        <item name="itemShapeInsetTop">6dp</item>
        <item name="itemShapeInsetBottom">6dp</item>
        <item name="itemBackground">@drawable/drawer_item_bg</item>
    </style>
    <style name="AppSafeAlertDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <!-- Fuerza fondo y textos legibles -->
        <item name="android:background">@android:color/white</item>
        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="android:textColorSecondary">@android:color/black</item>
    </style>


    <style name="ShapeAppearance.BlackHawk.DrawerItem" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="App.BottomSheetTheme" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <!-- Fondo del sheet -->
        <item name="bottomSheetStyle">@style/App.BottomSheetStyle</item>
    </style>

    <style name="App.BottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@color/sheet_bg</item>
    </style>

    <!-- Theme para mostrar UpdateRequiredActivity como pop-up flotante -->
    <style name="Theme.BlackHawk.UpdateDialog" parent="@style/Theme.BlackHawk">
        <!-- Ventana flotante -->
        <item name="android:windowIsFloating">true</item>
        <!-- Fondo transparente de la ventana, para que se vea solo la tarjeta -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- Dim del fondo -->
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <!-- No cerrar tocando afuera -->
        <item name="android:windowCloseOnTouchOutside">false</item>

        <!-- Ancho mínimo de la ventana (vertical/horizontal) para que no quede angosta -->
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

</resources>
