<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Título -->
    <TextView
        android:id="@+id/tvHeader"
        android:text="@string/consultas"
        android:textStyle="bold"
        android:textSize="20sp"
        android:letterSpacing="0.01"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- Campo de consulta en TextInputLayout -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilQuery"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:endIconMode="custom"
        app:endIconDrawable="@android:drawable/ic_menu_edit"
        app:endIconTint="?attr/colorPrimary"
        app:shapeAppearance="@style/ShapeAppearance.Material3.MediumComponent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtQuery"
            android:hint="@string/escribe_tu_consulta"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:imeOptions="actionSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="36dp" />
    </com.google.android.material.textfield.TextInputLayout>


    <!-- Selector de modo IA -->
    <LinearLayout
        android:id="@+id/rowMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/txtModeLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/modo_de_respuesta"
            android:textSize="14sp"
            android:alpha="0.85" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pro"
            android:checked="true" />
    </LinearLayout>

    <!-- Línea divisoria -->
    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp"
        app:dividerThickness="1dp" />

    <!-- Botón principal -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAsk"
        style="@style/Widget.Material3.Button"
        android:text="@string/consultar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:icon="@android:drawable/ic_menu_search"
        app:iconPadding="8dp"
        app:iconGravity="textStart" />

    <!-- Encabezado de referencias (oculto, compatibilidad) -->
    <TextView
        android:id="@+id/txtRefsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/referencias"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <!-- Lista de resultados (cards) + footer "Ver más" por ConcatAdapter -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCitations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="6dp"
        android:visibility="visible" />

</LinearLayout>
