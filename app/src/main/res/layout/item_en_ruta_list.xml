<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="3dp"
    app:cardUseCompatPadding="true"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtMatricula"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/uh_60l_mat_1091"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Icono de ruta con fondo tipo chip redondo -->
            <ImageView
                android:id="@+id/imgArrow"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_ruta"
                app:tint="?attr/colorPrimary" />
        </LinearLayout>

        <!-- INFO -->
        <TextView
            android:id="@+id/txtCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/categor_a_a"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtUbicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/ubicaci_n_b_a_m_no_2_ixtepec"
            android:textSize="12sp" />

        <!-- CHIPS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/txtProx"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_enruta_chip"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/_120_hrs"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtHorasDisp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_enruta_chip"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/_11_2_hrs_disp"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtHorasTotales"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_enruta_chip"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/hs_totales"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- META + ACTION en la misma fila -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Izquierda: meta info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtUltimaEdicion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/ltima_edici_n"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtTecnico"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/tecnico"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Derecha: botón -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemoveEnRuta"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:text="@string/quitar_de_en_ruta" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
