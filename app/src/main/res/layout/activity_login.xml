<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Slideshow de fondo (mismas IDs que usa LoginActivity) -->
    <ImageView
        android:id="@+id/slideA"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/slideB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:alpha="0" />

    <!-- Overlay cinematográfico (igual que Startup) -->
    <View
        android:id="@+id/bgOverlayLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/startup_overlay_cinematic" />

    <!-- Vignette (igual que Startup) -->
    <View
        android:id="@+id/bgVignetteLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/startup_vignette" />

    <!-- Contenido de login encima del fondo -->
    <LinearLayout
        android:id="@+id/loginContent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="200dp"
        android:padding="32dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Logo -->
        <ImageView
            android:contentDescription="@string/login_logo_description"
            android:src="@drawable/uh60_header"
            android:layout_width="120dp"
            android:layout_height="120dp" />

        <TextView
            android:text="@string/acceso_de_t_cnicos_uh_60l"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:layout_marginBottom="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etEmail"
            android:hint="@string/correo"
            android:textColorHint="#B3FFFFFF"
            android:autofillHints="emailAddress"
            android:inputType="textEmailAddress"
            android:textColor="@android:color/white"
            android:backgroundTint="@android:color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvForgetUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textAlignment="viewEnd"
            android:text="@string/olvidar_usuario"
            android:textColor="#B3FFFFFF" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autofillHints="password"
            android:backgroundTint="@android:color/white"
            android:drawableEnd="@drawable/ic_visibility_24"
            android:drawablePadding="8dp"
            android:hint="@string/contrase_a"
            android:inputType="textPassword"
            android:paddingEnd="4dp"
            android:saveEnabled="false"
            android:textColor="@android:color/white"
            android:textColorHint="#B3FFFFFF" />

        <CheckBox
            android:id="@+id/cbEnableBiometrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:button="@null"
            android:drawableStart="@drawable/checkbox_biometric_selector"
            android:drawablePadding="8dp"
            android:text="@string/habilitar_biometria"
            android:textColor="@android:color/white"
            android:visibility="gone" />

        <!-- Botón pro sin usar style, con colores del tema -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:text="@string/iniciar_sesi_n"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="?attr/colorOnPrimary"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="999dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBiometricLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/usar_biometria"
            android:textAllCaps="false"
            android:textColor="?attr/colorOnPrimary"
            android:visibility="gone"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="999dp"
            />

        <TextView
            android:id="@+id/tvGoRegister"
            android:text="@string/crear_cuenta_nueva"
            android:textColor="#B3FFFFFF"
            android:layout_marginTop="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/loginProgress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:importantForAccessibility="yes"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/login_status_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="10dp"
            app:strokeColor="@color/login_status_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="26dp"
                android:paddingEnd="28dp"
                android:paddingBottom="26dp">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp">

                    <ProgressBar
                        android:id="@+id/loginStatusSpinner"
                        style="?android:attr/progressBarStyleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminateTint="@color/primary" />

                    <ImageView
                        android:id="@+id/loginStatusSuccess"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_login_status_success"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvLoginStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/iniciando_sesion"
                    android:textColor="@color/login_status_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLoginStatusDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/validando_credenciales"
                    android:textColor="@color/login_status_detail"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</FrameLayout>
