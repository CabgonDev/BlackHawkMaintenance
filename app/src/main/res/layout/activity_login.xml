<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Slideshow de fondo (mismas IDs que usa LoginActivity) -->
    <ImageView
        android:id="@+id/slideA"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/slideB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:alpha="0" />

    <!-- Overlay cinematográfico (igual que Startup) -->
    <View
        android:id="@+id/bgOverlayLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/startup_overlay_cinematic" />

    <!-- Vignette (igual que Startup) -->
    <View
        android:id="@+id/bgVignetteLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/startup_vignette" />

    <!-- Contenido de login encima del fondo -->
    <LinearLayout
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="200dp"
        android:padding="32dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Logo -->
        <ImageView
            android:src="@drawable/uh60_header"
            android:layout_width="120dp"
            android:layout_height="120dp" />

        <TextView
            android:text="@string/acceso_de_t_cnicos_uh_60l"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:layout_marginBottom="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etEmail"
            android:hint="@string/correo"
            android:textColorHint="#B3FFFFFF"
            android:autofillHints="emailAddress"
            android:inputType="textEmailAddress"
            android:textColor="@android:color/white"
            android:backgroundTint="@android:color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etPassword"
            android:hint="@string/contrase_a"
            android:inputType="textPassword"
            android:textColor="@android:color/white"
            android:textColorHint="#B3FFFFFF"
            android:backgroundTint="@android:color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="password"
            android:layout_marginTop="12dp" />

        <!-- Botón pro sin usar style, con colores del tema -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:text="@string/iniciar_sesi_n"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="?attr/colorOnPrimary"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="999dp" />

        <TextView
            android:id="@+id/tvGoRegister"
            android:text="@string/crear_cuenta_nueva"
            android:textColor="#B3FFFFFF"
            android:layout_marginTop="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

</FrameLayout>
