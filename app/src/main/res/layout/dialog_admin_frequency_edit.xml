<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/etState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Estado"
            android:inputType="text" />

        <EditText
            android:id="@+id/etCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ciudad"
            android:inputType="text" />

        <EditText
            android:id="@+id/etAirport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Aeropuerto"
            android:inputType="text" />

        <EditText
            android:id="@+id/etIcao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ICAO"
            android:inputType="text" />

        <EditText
            android:id="@+id/etIata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="IATA (opcional)"
            android:inputType="text" />

        <EditText
            android:id="@+id/etType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tipo (TWR/GND/APP/VOR/DME...)"
            android:inputType="text" />

        <EditText
            android:id="@+id/etCallsign"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Callsign (opcional)"
            android:inputType="text" />

        <EditText
            android:id="@+id/etFreqMhz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Freq MHz (ej: 118.10)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/etFreqKhz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Freq kHz (opcional)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/etIdent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ident (opcional)"
            android:inputType="text" />

        <EditText
            android:id="@+id/etRemarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Remarks (opcional)"
            android:inputType="textMultiLine" />

        <CheckBox
            android:id="@+id/chkEmergency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency" />

    </LinearLayout>
</ScrollView>
