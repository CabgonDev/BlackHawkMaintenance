<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- TOOLBAR (encima) -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:title="Manual"
            app:titleTextColor="?attr/colorOnPrimary"
            app:navigationIconTint="?attr/colorOnPrimary"
            app:subtitleTextColor="?attr/colorOnPrimary"
            app:popupTheme="@style/ThemeOverlay.Material3.Light" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- PDF + overlays (debajo del toolbar) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.github.barteksc.pdfviewer.PDFView
            android:id="@+id/pdfView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Highlight overlay: placeholder (el highlight real se pinta en .onDraw) -->
        <com.cabgon.blackhawk.ui.pdf.PdfHighlightOverlay
            android:id="@+id/highlightOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Flash overlay: se usa para "marcar" el salto a un resultado -->
        <View
            android:id="@+id/searchFlash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:alpha="0"
            android:background="#80FFEB3B" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
