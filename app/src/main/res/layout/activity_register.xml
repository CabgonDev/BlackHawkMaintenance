<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Logo / identidad -->
        <ImageView
            android:src="@drawable/uh60_header"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:text="@string/registro_de_t_cnico_uh_60l"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Correo -->
        <EditText
            android:id="@+id/etEmailReg"
            android:hint="@string/correo"
            android:inputType="textEmailAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Contraseña -->
        <EditText
            android:id="@+id/etPasswordReg"
            android:hint="@string/contrase_a"
            android:inputType="textPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- Confirmar contraseña -->
        <EditText
            android:id="@+id/etPasswordConfirm"
            android:hint="@string/confirmar_contrase_a"
            android:inputType="textPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="4dp" />

        <!-- Datos del técnico -->
        <TextView
            android:text="@string/datos_del_t_cnico"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Grado -->
        <TextView
            android:text="@string/grado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Spinner
            android:id="@+id/spGradoReg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- Especialidad -->
        <TextView
            android:text="@string/especialidad"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Spinner
            android:id="@+id/spEspecialidadReg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Nombre -->
        <EditText
            android:id="@+id/etNombreReg"
            android:hint="@string/nombre_completo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Matrícula -->
        <EditText
            android:id="@+id/etMatriculaReg"
            android:hint="@string/matr_cula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Botón registrar -->
        <Button
            android:id="@+id/btnRegisterConfirm"
            android:text="@string/crear_cuenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Volver al login -->
        <TextView
            android:id="@+id/tvGoLogin"
            android:text="@string/ya_tienes_cuenta_iniciar_sesi_n"
            android:textColor="@android:color/holo_blue_light"
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
