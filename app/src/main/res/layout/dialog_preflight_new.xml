<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <TextView
            android:id="@+id/tvFechaHoraResumen"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textStyle="bold"
            android:text="Se registrará: --/--/---- · --:--"
            android:paddingBottom="8dp"/>

        <!-- Mat. Aeronave -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMatAeronave"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Mat. Aeronave">
            <AutoCompleteTextView
                android:id="@+id/etMatAeronave"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="none"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Grado -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilGrado"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:hint="Grado">
            <AutoCompleteTextView
                android:id="@+id/etGrado"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="none"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Especialidad -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEsp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:hint="Especialidad">
            <AutoCompleteTextView
                android:id="@+id/etEsp"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="none"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Nombre técnico -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTecnicoNombre"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:hint="Nombre (técnico)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTecnicoNombre"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Hs Totales -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilHsTot"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:hint="Hs. Totales">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etHsTot"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="numberDecimal"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Hs Disponibles -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilHsDisp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:hint="Hs. Disp.">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etHsDisp"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="numberDecimal"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Matrícula del técnico (para pie del PDF) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMatTec"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:hint="Matrícula (técnico)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMatTec"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</ScrollView>
