<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="14dp"
    android:paddingBottom="18dp">

    <!-- Handle -->
    <View
        android:layout_width="42dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:alpha="0.35"
        android:background="@android:color/darker_gray" />

    <!-- Encabezado: ICAO badge + Airport name -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- ICAO badge sólido -->
        <TextView
            android:id="@+id/txtIcaoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="MMTO"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <!-- Airport name -->
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Línea secundaria (si la quieres oculta, se puede poner gone en Kotlin) -->
    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:alpha="0.85" />

    <!-- Chips -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:singleLine="false"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="6dp" />

    <!-- Headers de columnas -->
    <LinearLayout
        android:id="@+id/rowFreqHeaders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtHdrFreq"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="FRECUENCIA"
            android:textStyle="bold"
            android:gravity="center"
            android:alpha="0.7"
            android:textAppearance="?attr/textAppearanceLabelSmall" />

        <TextView
            android:id="@+id/txtHdrService"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SERVICIO"
            android:gravity="center"
            android:textStyle="bold"
            android:alpha="0.7"
            android:textAppearance="?attr/textAppearanceLabelSmall" />

        <TextView
            android:id="@+id/txtHdrCallsign"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CALLSIGN"
            android:gravity="center"
            android:textStyle="bold"
            android:alpha="0.7"
            android:textAppearance="?attr/textAppearanceLabelSmall" />
    </LinearLayout>

    <!-- Card PRO (3 columnas) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFrequency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardUseCompatPadding="true"
        app:cardElevation="0dp"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/rowFreqPro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/txtFrequency"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="118.00 MHz"
                android:textStyle="bold"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/txtFreqService"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="TWR"
                android:textStyle="bold"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <TextView
                android:id="@+id/txtFreqCallsign"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="TOLUCA"
                android:textStyle="bold"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:maxLines="2"
                android:singleLine="false"
                android:ellipsize="none" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Botones copiar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyFreq"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/copiar_frecuencia" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyAll"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/copiar_todo" />
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/detalle"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <LinearLayout
        android:id="@+id/boxRemarks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/observaciones"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtRemarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </LinearLayout>

</LinearLayout>
