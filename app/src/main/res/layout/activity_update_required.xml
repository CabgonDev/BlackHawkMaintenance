<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:foregroundGravity="center">

    <!-- Contenedor tipo tarjeta centrada -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

        <LinearLayout
            android:id="@+id/updateCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_update_card"
            android:padding="20dp">

            <ImageView
                android:id="@+id/ivAppLogo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:src="@drawable/ic_uh60_front"
                android:contentDescription="@string/logo_de_la_aplicaci_n" />

            <TextView
                android:id="@+id/tvUpdateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/actualizaci_n_requerida"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUpdateBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/tu_versi_n_actual_es_menor_que_la_m_nima_requerida_debes_actualizar_para_continuar_utilizando_la_aplicaci_n"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvUpdateNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/notas_de_la_versi_n"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/pbUpdate"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/tvUpdateProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textSize="13sp"
                android:textColor="@android:color/darker_gray" />

            <!-- Botones en fila: Cancelar + Descargar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="18dp"
                tools:ignore="ButtonStyle">

                <Button
                    android:id="@+id/btnCancelDownload"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cancelar" />

                <Button
                    android:id="@+id/btnDownloadInstall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/descargar_e_instalar_apk" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/nota_android_te_pedir_confirmar_la_instalaci_n_porque_la_distribuci_n_es_fuera_de_play_store"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
