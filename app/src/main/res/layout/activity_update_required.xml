<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvUpdateTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/actualizaci_n_requerida"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUpdateBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tu_versi_n_es_antigua_debes_actualizar"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvUpdateNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/notas"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/pbUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp" />

        <Button
            android:id="@+id/btnDownloadInstall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/descargar_e_instalar_apk" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/nota_android_te_pedir_confirmar_la_instalaci_n_distribuci_n_fuera_de_play_store"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
