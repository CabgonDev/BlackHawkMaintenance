<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/adminHomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtAdminTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/panel_admin"
        android:textStyle="bold"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/txtAdminSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/admin_shell_subtitle"
        android:paddingTop="6dp"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txtAdminRole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rol: —"
        android:paddingTop="10dp"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txtAdminHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Solo se muestran módulos permitidos por rol."
        android:paddingTop="6dp"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/txtModulesTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/admin_modulos"
        android:textStyle="bold"
        android:paddingTop="14dp"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerModules"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="10dp" />

</LinearLayout>
