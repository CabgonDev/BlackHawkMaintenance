<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootStartup"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background slideshow (2 capas para crossfade) -->
    <ImageView
        android:id="@+id/imgBgA"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/imgBgB"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Cinematic overlay (gradiente) -->
    <View
        android:id="@+id/bgOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/startup_overlay_cinematic"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Vignette -->
    <View
        android:id="@+id/bgVignette"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/startup_vignette"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- SELECCIÓN (centrado) -->
    <LinearLayout
        android:id="@+id/selectionBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtSelectPackage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/selecciona_paquete_de_manuales"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:textAlignment="center"
            android:shadowColor="#B0000000"
            android:shadowRadius="10"
            android:shadowDx="0"
            android:shadowDy="3"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/iads"
            android:layout_marginTop="16dp"
            app:cornerRadius="18dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSikorsky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sikorsky"
            android:layout_marginTop="10dp"
            app:cornerRadius="18dp"/>
    </LinearLayout>

    <!-- PROGRESO + END SCREEN (centrado) -->
    <LinearLayout
        android:id="@+id/centerBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/pbOta"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/txtOtaStatus"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textAlignment="center"
            android:textColor="@android:color/white"
            android:layout_marginTop="12dp"
            android:shadowColor="#B0000000"
            android:shadowRadius="10"
            android:shadowDx="0"
            android:shadowDy="3"/>

        <!-- heli logo
        <ImageView
            android:id="@+id/imgBrandIcon"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_uh60_front"
            android:contentDescription="@null"
            android:alpha="0.95"
            android:layout_marginBottom="12dp"/>
        -->

        <TextView
            android:id="@+id/txtBrandTitle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/blackhawk_nmaintenance"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textSize="34sp"
            android:letterSpacing="0.12"
            android:textColor="@android:color/white"
            android:layout_marginTop="8dp"
            android:shadowColor="#D0000000"
            android:shadowRadius="16"
            android:shadowDx="0"
            android:shadowDy="6"/>

        <!-- Si en algún momento quieres usar un logo generado, agrega un ImageView así:
        <ImageView
            android:id="@+id/imgBrand"
            android:visibility="gone"
            android:layout_width="240dp"
            android:layout_height="120dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@drawable/brand_blackhawk_maintenance" />
        -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnter"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/entrar"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:background="@drawable/btn_enter_tactical"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="16sp"
            app:icon="@android:drawable/ic_media_play"
            app:iconPadding="10dp"
            app:iconGravity="textStart"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
