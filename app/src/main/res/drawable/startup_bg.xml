<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base (verde oscuro) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#062A28"
                android:centerColor="#083532"
                android:endColor="#041E1C"/>
        </shape>
    </item>

    <!-- “Digital blocks” sutiles (sin imagen externa) -->
    <item android:alpha="0.22">
        <shape android:shape="rectangle">
            <size android:width="24dp" android:height="24dp"/>
            <solid android:color="#0E4A45"/>
        </shape>
    </item>

    <item android:alpha="0.10">
        <shape android:shape="rectangle">
            <size android:width="48dp" android:height="48dp"/>
            <solid android:color="#0A3B37"/>
        </shape>
    </item>

</layer-list>
