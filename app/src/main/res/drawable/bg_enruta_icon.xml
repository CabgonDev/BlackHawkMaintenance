<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fondo ligeramente translúcido -->
    <solid android:color="#14FFFFFF" />

    <!-- Borde fino en colorPrimary -->
    <stroke
        android:width="1dp"
        android:color="?attr/colorPrimary" />

    <!-- Esquinas totalmente redondeadas (circulito) -->
    <corners android:radius="999dp" />

    <!-- Padding interno por si se usa como fondo en otros lados -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />

</shape>
