<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fondo transparente -->
    <solid android:color="@android:color/transparent" />

    <!-- Borde fino en colorPrimary -->
    <stroke
        android:width="1dp"
        android:color="?attr/colorPrimary" />

    <!-- Esquinas bien redondeadas tipo chip -->
    <corners android:radius="999dp" />

    <!-- Padding interno para que se vea “rellenito” -->
    <padding
        android:left="12dp"
        android:top="6dp"
        android:right="12dp"
        android:bottom="6dp" />

</shape>
